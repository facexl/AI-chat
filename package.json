{
  "name": "aichat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "vite --mode content",
    "build": "npm run build:content && npm run build:popup && npm run build:background",
    "build:content": "vite build --mode content",
    "build:popup": "vite build --mode popup",
    "build:background": "vite build --mode background",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.0",
    "ant-design-vue": "^4.2.0",
    "eventsource-parser": "^3.0.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-multimd-table": "^4.2.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@vitejs/plugin-vue": "^6.0.8",
    "less": "^4.2.0",
    "typescript": "^5.5.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vue-tsc": "^2.1.0"
  }
}
