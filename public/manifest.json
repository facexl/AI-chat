{
    "manifest_version": 3,
    "name": "AI-chat",
    "description": "AI-chat 是一款 AI 驱动的划词聊天、划词翻译 Chrome 插件，支持预设引导语",
    "version": "2.0.0",
    "minimum_chrome_version": "88",
    "action": {
        "default_icon": "icon.png",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["aichat.css", "icon.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions": ["storage", "tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": ["https://dashscope.aliyuncs.com/*", "https://coding.dashscope.aliyuncs.com/*"]
}
